# Tender Vault Cloud Functions environment.
# Copy to functions/.env and fill in real values. NEVER commit functions/.env.

# Anthropic (Claude) — used ONLY server-side for tender parsing.
ANTHROPIC_API_KEY=
# Optional: override the Claude model used for parsing.
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Service account JSON for the Admin SDK (string-encoded JSON or a path,
# depending on your deploy setup). In deployed Functions the runtime service
# account is used automatically; this is for local/emulator use.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Notification providers (alerts are stubbed in Phase 1 — keys reserved).
SMS_PROVIDER_API_KEY=
EMAIL_PROVIDER_API_KEY=
