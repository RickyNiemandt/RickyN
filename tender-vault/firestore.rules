rules_version = '2';

// ============================================================
// Tender Vault — Firestore security rules
// Tenant-scoped (companyId custom claim) + RBAC (admin/member)
// All writes to auditLog, requirements, and status fields are
// server-side only (Cloud Functions). Clients may upload vault
// doc metadata via registerVaultDoc function only.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function companyMember(companyId) {
      return signedIn() && request.auth.token.companyId == companyId;
    }

    function companyAdmin(companyId) {
      return companyMember(companyId) && request.auth.token.role == 'admin';
    }

    // Fields the client may set when writing vault docs directly.
    // Actual creation goes through registerVaultDoc Cloud Function
    // which also writes the auditLog — this rule is belt-and-suspenders
    // for Storage-trigger patterns if added later.
    function vaultWriteOnly() {
      return request.resource.data.keys().hasOnly([
        'type','fileName','storagePath','fileSize','mimeType',
        'expiresAt','uploadedAt','uploadedBy','version','notes'
      ]);
    }

    // ── companies ────────────────────────────────────────────

    match /companies/{companyId} {
      // Members may read their own company record.
      allow read: if companyMember(companyId);
      // Creation handled by provisionCompany Cloud Function only.
      allow write: if false;

      // ── users sub-collection ─────────────────────────────
      match /users/{uid} {
        allow read: if companyMember(companyId);
        // Managed by addUser Cloud Function only.
        allow write: if false;
      }

      // ── vault documents ───────────────────────────────────
      match /vault/{docId} {
        allow read: if companyMember(companyId);
        // Creation goes through registerVaultDoc function (server writes auditLog).
        allow create: if false;
        // Updates go through server-side functions only.
        allow update: if false;
        // Only admins may delete; storagePath cleanup done by deleteVaultDoc function.
        allow delete: if false;
      }

      // ── tenders ───────────────────────────────────────────
      match /tenders/{tenderId} {
        allow read: if companyMember(companyId);
        // Creation goes through registerTender function.
        allow create: if false;
        // Status updates (parsed, matched, error) are server-side only.
        allow update: if false;
        allow delete: if companyAdmin(companyId);

        // ── requirements sub-collection ───────────────────
        match /requirements/{reqId} {
          allow read: if companyMember(companyId);
          // Written by parseTender + matchRequirements functions only.
          allow create: if false;
          // Members may confirm (update confirmedAt/confirmedBy/acknowledgedExpiry).
          // All other fields (matchStatus, vaultDocId, downloadUrl) are server-only.
          allow update: if companyMember(companyId) &&
            request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['confirmedAt','confirmedBy','acknowledgedExpiry']);
          allow delete: if false;
        }
      }

      // ── audit log ─────────────────────────────────────────
      match /auditLog/{logId} {
        // Admins may read the audit log; no client writes ever.
        allow read: if companyAdmin(companyId);
        allow write: if false;
      }
    }
  }
}
