rules_version = '2';

// ============================================================
// Tender Vault — Cloud Storage security rules
// Every path is scoped to companies/{companyId}/... and requires
// request.auth.token.companyId == companyId (custom claim).
// Reads require membership; writes require membership.
// ============================================================

service firebase.storage {
  match /b/{bucket}/o {
    match /companies/{companyId}/{allPaths=**} {
      // Members of the company may read any file in their company's path.
      allow read: if request.auth != null &&
                     request.auth.token.companyId == companyId;

      // Members may upload vault docs and tenders (max 50 MB).
      allow write: if request.auth != null &&
                      request.auth.token.companyId == companyId &&
                      request.resource.size <= 50 * 1024 * 1024;
    }
  }
}
