# Charm Systems — server-side integration secrets.
# Copy to `.env.local` (gitignored) and fill in. These are NOT prefixed with
# NEXT_PUBLIC_, so they are only ever available to server code (API routes /
# Server Actions) and are never sent to the browser.

# Firebase Admin service account (auth + Firestore). Either raw JSON on one line
# or base64-encoded JSON. When unset, lead submissions are logged server-side
# instead of persisted, so the app still runs locally.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Shared secret used to verify inbound webhook signatures (HMAC-SHA256).
WEBHOOK_SECRET=

# Example third-party API key (e.g. transactional email), read server-side only.
EMAIL_API_KEY=
